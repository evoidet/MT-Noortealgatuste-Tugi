{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2023",
    "types": ["node"]
  },
  "include": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "scripts/**/*.mjs"
  ]
}
